{
  "defaultValue": {
    "port": 443
  },
  "properties": [
    {
      "name": "host",
      "label": "主机地址",
      "uiComponent": "Input",
      "required": true,
      "placeholder": "例如：api.example.com"
    },
    {
      "name": "port",
      "label": "端口",
      "uiComponent": "InputNumber",
      "typeOptions": {
        "min": 1,
        "max": 65535,
        "style": "width: 200px"
      }
    },
    {
      "name": "apiKey",
      "label": "API Key",
      "uiComponent": "Password",
      "required": true
    },
    {
      "name": "_testConn",
      "label": "测试连接",
      "uiComponent": "TestButton",
      "typeOptions": {
        "invokeMethod": {
          "method": "test",
          "provider": "credentials",
          "credentialsType": "{{CREDENTIAL_TYPE}}",
          "dependsOn": ["host", "port", "apiKey"],
          "buttonText": "测试连接",
          "buttonType": "primary"
        }
      }
    }
  ]
}
