package {{PACKAGE}}.credentials;

import cn.buildify.bundle.api.credentials.CredentialsDescription;
import cn.buildify.bundle.api.credentials.CredentialsMethodRequest;
import cn.buildify.bundle.api.credentials.CredentialsProvider;
import lombok.extern.slf4j.Slf4j;

import java.net.UnknownHostException;
import java.util.List;
import java.util.Map;
import java.util.concurrent.CompletableFuture;

@Slf4j
@CredentialsDescription(
        // type 为 PascalCase 唯一标识，必须与表单 typeOptions.credentialsType
        // 以及 propertiesFile 文件名逐字一致
        type = "{{CREDENTIAL_TYPE}}",
        label = "{{CREDENTIAL_LABEL}}",
        propertiesFile = "credentials/{{CREDENTIAL_TYPE}}.json")
public class {{CREDENTIAL_TYPE}}Provider implements CredentialsProvider {

    @Override
    public CompletableFuture<Object> execute(CredentialsMethodRequest request) {

        // 测试连接：方法名固定为 "test"
        if (request.isTestConnection()) {
            return CompletableFuture.supplyAsync(() -> {
                String host = request.requireString("host");
                int port = request.getInteger("port", 443);
                try {
                    int count = testConnect(host, port, request.requireString("apiKey"));
                    // 成功消息带上连接目标和关键资源数量，便于用户确认连对了地方
                    return Map.of("success", true,
                            "message", String.format("连接成功（%s），共 %d 个资源", host, count));
                } catch (Exception e) {
                    // 不要把凭证内容写进返回信息，也不要直接暴露原始异常
                    log.warn("[{{CREDENTIAL_TYPE}}] 测试连接失败 host={} port={}", host, port);
                    return Map.of("success", false, "message", classifyError(e));
                }
            });
        }

        // 动态加载下拉选项，方法名与表单 loadOptions.method 一致
        if (request.is("getResources")) {
            return CompletableFuture.supplyAsync(() -> List.of(
                    Map.of("label", "示例资源", "value", "example")));
        }

        return CompletableFuture.failedFuture(
                new UnsupportedOperationException("不支持的方法: " + request.getMethod()));
    }

    /** @return 拉取到的资源数量，用于拼接成功提示 */
    private int testConnect(String host, int port, String apiKey) {
        // TODO 实现真实的连通性校验
        return 0;
    }

    /** 失败原因按类型分类，给用户可操作的提示而不是裸异常信息 */
    private String classifyError(Exception e) {
        Throwable cause = e.getCause();
        String msg = e.getMessage() == null ? "" : e.getMessage();
        if (cause instanceof UnknownHostException) {
            return "网络错误：无法解析主机地址，请检查地址或网络连接";
        }
        if (msg.contains("Connection refused")) {
            return "网络错误：连接被拒绝，请检查地址和端口";
        }
        if (msg.contains("timed out")) {
            return "网络超时：请检查地址或网络连接";
        }
        return "连接失败：" + msg;
    }
}
