package {{PACKAGE}}.nodes;

import {{PACKAGE}}.support.TriggerGuard;
import cn.buildify.bundle.api.Context;
import cn.buildify.bundle.api.FlowNode;
import cn.buildify.bundle.api.FlowNodeDescription;
import cn.buildify.bundle.api.http.HttpMethod;
import cn.buildify.bundle.api.http.Route;
import cn.buildify.bundle.api.http.RoutingContext;
import cn.buildify.bundle.api.json.JsonValue;
import cn.buildify.bundle.api.json.JsonValueFactory;
import cn.buildify.bundle.api.message.Message;
import cn.buildify.bundle.api.status.NodeStatus;
import cn.buildify.bundle.api.validation.Validator;
import lombok.extern.slf4j.Slf4j;

import java.util.Set;
import java.util.UUID;
import java.util.regex.Pattern;

@Slf4j
@FlowNodeDescription(
        name = "{{NODE_NAME}}",
        propertiesFile = "properties/{{NODE_NAME}}.json",
        isTrigger = true,
        hasInput = false)
public class {{NODE_NAME}} implements FlowNode {

    private static final Pattern REQUEST_ID = Pattern.compile("[A-Za-z0-9._:-]{1,128}");

    private static final String HEALTHY_TEXT = "监听中";

    private Route route;
    private volatile TriggerGuard guard;
    private String triggerNodeId;
    private String workerId;

    @Override
    public void initialize(Context context, JsonValue parameters) {
        this.triggerNodeId = context.getWorkflowNodeId();
        this.workerId = context.getWorkerId();
        String path = Validator.of(parameters.path("path").asText(""), "path")
                .notBlank("path 不能为空")
                .get();
        this.guard = new TriggerGuard(parameters.path("maxPerSecond").asInt(0));

        this.route = Route.create(Set.of(HttpMethod.POST), path)
                .timeout(parameters.path("timeout").asInt(5000))
                // 入站认证用 route.authenticator(...)，在读 body 之前执行。
                // 本模板会把 JSON 解析成对象并立刻回通用成功。微信支付 / 支付宝 / Stripe
                // 这类按原文验签的回调不要用本模板，见 coding-rules.md「按原文验签的回调触发器」。
                .handler(rc -> handleRequest(context, rc));

        context.getRouter().register(route);
        context.setStatus(NodeStatus.builder().color("green").text(HEALTHY_TEXT).build());
    }

    /** 路由属于生命周期资源，任何相关参数变化都必须重启 */
    @Override
    public boolean isRestartRequired(JsonValue newParameters, JsonValue oldParameters) {
        return !newParameters.equals(oldParameters);
    }

    @Override
    public void onMsg(Context context, Message<?> message) {
        // Webhook 触发器无输入连接点
    }

    private void handleRequest(Context context, RoutingContext rc) {
        TriggerGuard currentGuard = guard;
        if (currentGuard == null) {
            rc.fail(503, "节点已停止");
            return;
        }
        // 先限流再读 body：超过每秒上限或下游背压时直接 429，让调用方稍后重试
        if (!currentGuard.admit(context)) {
            tooManyRequests(rc);
            return;
        }
        try {
            String body = rc.request().body();
            String requestId = rc.request().getHeader("X-Request-Id");
            // 外部追踪 ID 合法时沿用，否则每次请求生成一个。与消息头 __correlationId 相同。
            String eventId = requestId != null && REQUEST_ID.matcher(requestId).matches()
                    ? requestId
                    : UUID.randomUUID().toString();

            // 触发器 payload 直接放根级业务字段，禁止再包一层 output
            JsonValue payload = JsonValueFactory.objectNode()
                    .put("triggerNodeId", triggerNodeId)
                    .put("eventId", eventId)
                    .put("workerId", workerId)
                    .put("body", parseBody(body))
                    .put("clientIp", rc.getClientIP());

            Message<JsonValue> msg = context.createTriggerMessage(payload, eventId);
            boolean accepted;
            try {
                // tryTellSuccess：下游过载时不入队并返回 false，不能用 tellSuccess（会被引擎静默丢弃）
                accepted = context.tryTellSuccess(msg);
            } finally {
                // 必须且只调一次：记录触发器的执行次数、QPS 与耗时（框架不去重）。
                // 特殊触发器可按说明挪到真正结束处，但不能删除
                context.complete(msg);
            }
            if (!accepted) {
                currentGuard.recordDropped(context);
                tooManyRequests(rc);
                return;
            }
            currentGuard.recordEmitted(context, HEALTHY_TEXT);

            rc.response().statusCode(200)
                    .contentType("application/json")
                    .write("{\"code\":200,\"msg\":\"success\"}")
                    .end();
        } catch (Exception e) {
            // 详细原因只写日志，不回传给调用方
            log.error("[{{NODE_NAME}}] 处理请求失败", e);
            rc.fail(500, "处理请求失败");
        }
    }

    private static void tooManyRequests(RoutingContext rc) {
        rc.response().statusCode(429)
                .putHeader("Retry-After", "1")
                .contentType("application/json")
                .write("{\"code\":429,\"msg\":\"too many requests\"}")
                .end();
    }

    /** 幂等释放：未注销的路由持有 handler lambda，会钉住 ClassLoader */
    @Override
    public void destroy(Context context) {
        if (route != null) {
            context.getRouter().unregister(route);
            route = null;
        }
        if (guard != null) {
            guard.reset();
            guard = null;
        }
    }

    private JsonValue parseBody(String body) {
        if (body == null || body.isBlank()) {
            return JsonValueFactory.objectNode();
        }
        try {
            return JsonValueFactory.fromJson(body);
        } catch (Exception e) {
            return JsonValueFactory.objectNode().put("raw", body);
        }
    }
}
