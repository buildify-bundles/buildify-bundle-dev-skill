{
  "defaultValue": {
    "timeout": 5000,
    "maxPerSecond": 0
  },
  "properties": [
    {
      "name": "path",
      "label": "监听路径",
      "uiComponent": "Input",
      "required": true,
      "hint": "修改后节点将自动重启并重新注册路由",
      "placeholder": "/webhook/my-path"
    },
    {
      "name": "timeout",
      "label": "超时（毫秒）",
      "uiComponent": "InputNumber",
      "typeOptions": {
        "min": 100,
        "max": 60000,
        "style": "width: 200px"
      }
    },
    {
      "name": "maxPerSecond",
      "label": "每秒最多请求",
      "uiComponent": "InputNumber",
      "hint": "0 表示不限速。设为正整数后按该速率限速；下游处理不过来时仍返回 429 和 Retry-After",
      "typeOptions": {
        "min": 0,
        "max": 1000,
        "style": "width: 200px"
      }
    }
  ]
}
