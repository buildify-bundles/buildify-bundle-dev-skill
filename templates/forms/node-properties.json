{
  "defaultValue": {
    "method": "GET",
    "timeout": 30
  },
  "properties": [
    {
      "name": "url",
      "label": "请求地址",
      "uiComponent": "Input",
      "required": true,
      "expression": true,
      "droppable": true,
      "placeholder": "https://api.example.com/users",
      "rules": [
        { "pattern": "^(=|https?://)", "message": "必须以 http:// 或 https:// 开头" }
      ],
      "typeOptions": {
        "maxlength": 500
      }
    },
    {
      "name": "method",
      "label": "请求方法",
      "uiComponent": "RadioButtonGroup",
      "required": true,
      "options": [
        { "label": "GET", "value": "GET" },
        { "label": "POST", "value": "POST" },
        { "label": "PUT", "value": "PUT" },
        { "label": "DELETE", "value": "DELETE" }
      ]
    },
    {
      "name": "body",
      "label": "请求体",
      "uiComponent": "JsonExpressionInput",
      "displayOptions": {
        "show": { "method": ["POST", "PUT"] }
      }
    },
    {
      "name": "timeout",
      "label": "超时（秒）",
      "uiComponent": "InputNumber",
      "hint": "更改超时后节点将自动重启",
      "typeOptions": {
        "min": 1,
        "max": 300,
        "style": "width: 200px"
      }
    }
  ]
}
